 "insights": [
  {
   "concept": "Generation versus demand",
   "explanation": "Electrical power cannot be stored in the wires. Any gap between what loads demand and what sources deliver is covered by the battery until it cannot be, then loads go dark.",
   "id": "power.generation_vs_demand",
   "matters_later": "On the Moon, the Sun sets for days and there is no grid to fall back on.",
   "observation": "When bus B dropped, the station kept drawing the same power from less supply.",
   "provenance": {
    "classification": "educational_abstraction",
    "evidence_refs": [],
    "note": null
   },
