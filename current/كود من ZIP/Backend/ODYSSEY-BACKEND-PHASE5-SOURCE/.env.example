# ODYSSEY backend configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every variable is optional: with none set, the API runs on a local SQLite file, in-memory
# realtime bus and the offline mock ORION provider — zero infrastructure, zero cost.

# --- runtime -------------------------------------------------------------------------------
# development | test | production
ODYSSEY_ENVIRONMENT=development
ODYSSEY_LOG_LEVEL=INFO
ODYSSEY_LOG_JSON=true

# --- database ------------------------------------------------------------------------------
# SQLite (default, no server needed):
ODYSSEY_DATABASE_URL=sqlite+aiosqlite:///./odyssey-dev.db
# PostgreSQL (docker compose / production). Use your own credentials:
# ODYSSEY_DATABASE_URL=postgresql+asyncpg://USER:REDACTED_SECRET@localhost:5432/odyssey
# Create tables on startup (dev convenience only; production uses `alembic upgrade head`):
ODYSSEY_AUTO_CREATE_SCHEMA=false

# --- redis (optional) ----------------------------------------------------------------------
# Enables cross-process realtime fan-out and the shared NASA data cache.
# ODYSSEY_REDIS_URL=redis://localhost:6379/0

# --- HTTP / security -----------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (empty = no CORS headers).
# ODYSSEY_CORS_ORIGINS=http://localhost:5173
ODYSSEY_MAX_REQUEST_BYTES=65536
ODYSSEY_RATE_LIMIT_PER_MINUTE=120
ODYSSEY_RATE_LIMIT_EXPENSIVE_PER_MINUTE=20
ODYSSEY_MAX_ADVANCE_TICKS=240
ODYSSEY_SNAPSHOT_INTERVAL_TICKS=24

# --- ORION AI explanation layer --------------------------------------------------------------
# "mock" is deterministic, offline and free. "openai_compatible" works with any
# /chat/completions endpoint, e.g. a local Ollama (free): http://localhost:11434/v1
ODYSSEY_AI_PROVIDER=mock
# ODYSSEY_AI_BASE_URL=http://localhost:11434/v1
# ODYSSEY_AI_MODEL=llama3.1
# Only if your provider needs one:
# ODYSSEY_AI_API_KEY=
ODYSSEY_AI_TIMEOUT_SECONDS=20

# --- NASA data (optional) ------------------------------------------------------------------
# Remote fetching is off by default; local fixtures are used and flagged as such.
ODYSSEY_NASA_REMOTE_ENABLED=false
# Free key from https://api.nasa.gov :
# ODYSSEY_NASA_API_KEY=
ODYSSEY_NASA_CACHE_TTL_SECONDS=86400
# ODYSSEY_NASA_CACHE_DIR=./.cache/nasa
