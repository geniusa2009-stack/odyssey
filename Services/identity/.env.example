# ODYSSEY identity service. Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB connection string (database name in the path), e.g. MongoDB Atlas.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/odyssey?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
# true only in CI/test: fail fast if the initial connection fails.
DB_STARTUP_FAIL_FAST=false

# The game is not a browser (no Origin header), so CORS only matters for the
# public account-deletion page if it is hosted on another origin. HTTPS only in production.
CORS_ALLOWED_ORIGINS=
JSON_BODY_LIMIT=768kb

RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_ACCOUNT_FAILURES_MAX=10
RATE_LIMIT_AUTH_IP_FAILURES_MAX=100
RATE_LIMIT_SAVE_WINDOW_MS=60000
RATE_LIMIT_SAVE_MAX=30

# Generate real secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Two DIFFERENT values. With NODE_ENV=production the server refuses to start if a secret is
# shorter than 32 characters, looks like a placeholder, or both are equal.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL_DAYS=30

BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info

# Cloud saves: max size of one save (bytes) and slots per player.
SAVE_MAX_BYTES=524288
SAVE_MAX_SLOTS=3

# Public HTTPS base URL of this service (account-deletion page link).
PUBLIC_BASE_URL=
