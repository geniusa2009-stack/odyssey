{
  "name": "odyssey-identity",
  "version": "1.0.0",
  "description": "ODYSSEY identity service: accounts, sessions (JWT access + rotating opaque refresh tokens), player profile, cloud saves and Google Play account deletion. Auth architecture ported from the AgriSmart identity service.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development LOG_LEVEL=debug node --watch src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "accounts:finish-deletions": "node scripts/finishAccountDeletions.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0"
  }
}
