Packaged/
Archive/

# ---- secrets and local configuration (never committed)
.env
.env.*
*.pem
*.key
Config/User*.ini
Config/Local*.ini

# ---- development automation (Unreal MCP / editor agents) temporary files
.unreal-mcp/
.mcp/
*.mcp.tmp
Saved/UnrealMCP/
Saved/MCP/

# ---- native protocol tooling
Tools/ProtocolCore/build/
__pycache__/
*.pyc

# ---- OS
.DS_Store
Thumbs.db

# ---- macOS verification runner output (Tools/Mac)
Logs/

